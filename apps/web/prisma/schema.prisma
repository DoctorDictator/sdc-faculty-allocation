generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  HOD
  FACULTY
}

enum EventStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StaffingRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ScheduleStatus {
  PROPOSED
  PUBLISHED
  SUPERSEDED
  REJECTED
}

enum DisruptionType {
  ABSENCE
  EVENT_CHANGE
  REBALANCE
  ASSIGNMENT
}

model Faculty {
  id               String             @id @default(cuid())
  employeeCode     String             @unique
  name             String
  title            String
  department       String
  skills           String[]           @default([])
  active           Boolean            @default(true)
  targetMinutes    Int                @default(0)
  maxMinutes       Int
  committedMinutes Int                @default(0)
  availability     AvailabilityBlock[]
  assignments      Assignment[]
  preferences      PreferenceCost[]
  disruptions      Disruption[]
  staffingRequests EventStaffingRequest[]
  user             User?
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)

  @@index([active, department])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(FACULTY)
  facultyId    String?  @unique
  faculty      Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

model Event {
  id        String      @id @default(cuid())
  name      String
  startsAt  DateTime    @db.Timestamptz(3)
  endsAt    DateTime    @db.Timestamptz(3)
  priority  Int         @default(1)
  status    EventStatus @default(PLANNED)
  duties    Duty[]
  disruptions Disruption[]
  staffingRequest EventStaffingRequest?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@index([startsAt, status])
}

model EventStaffingRequest {
  id              String                @id @default(cuid())
  requesterId     String
  requester       Faculty               @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  eventId         String?               @unique
  event           Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventName       String
  startsAt        DateTime              @db.Timestamptz(3)
  endsAt          DateTime              @db.Timestamptz(3)
  requestedRole   String
  requestedCount  Int
  reason          String?
  status          StaffingRequestStatus @default(PENDING)
  approvedRole    String?
  approvedCount   Int?
  requiredSkill   String?
  responseNote    String?
  reviewedBy      String?
  reviewedAt      DateTime?             @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([requesterId, createdAt])
}

model Duty {
  id             String          @id @default(cuid())
  eventId        String
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role           String
  requiredSkill  String?
  positionIndex  Int             @default(1)
  minutes        Int
  assignments    Assignment[]
  preferences    PreferenceCost[]

  @@unique([eventId, role, positionIndex])
  @@index([eventId])
}

model AvailabilityBlock {
  id          String   @id @default(cuid())
  facultyId   String
  faculty     Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  reason      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([facultyId, startsAt, endsAt])
}

model PreferenceCost {
  dutyId    String
  duty      Duty    @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  cost      Int     @default(5)

  @@id([dutyId, facultyId])
}

model ScheduleVersion {
  id            Int            @id @default(autoincrement())
  parentId      Int?
  parent        ScheduleVersion? @relation("VersionLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children      ScheduleVersion[] @relation("VersionLineage")
  status        ScheduleStatus @default(PROPOSED)
  solver        String
  solverStatus  String
  snapshotHash  String
  objectiveJson Json?
  createdBy     String
  approvedBy    String?
  rejectedBy    String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  approvedAt    DateTime?      @db.Timestamptz(3)
  rejectedAt    DateTime?      @db.Timestamptz(3)
  rejectionReason String?
  assignments   Assignment[]
  disruptions   Disruption[]
  solverRuns    SolverRun[]

  @@index([status, createdAt])
}

model SolverRun {
  id                Int              @id @default(autoincrement())
  scheduleVersionId Int?
  scheduleVersion   ScheduleVersion? @relation(fields: [scheduleVersionId], references: [id], onDelete: SetNull)
  solver            String
  status            String
  wallTimeMs        Int?
  objectiveJson     Json?
  statisticsJson    Json?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([scheduleVersionId])
}

model Assignment {
  id                String          @id @default(cuid())
  scheduleVersionId Int
  scheduleVersion   ScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)
  dutyId            String
  duty              Duty            @relation(fields: [dutyId], references: [id], onDelete: Restrict)
  facultyId         String
  faculty           Faculty         @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  protected         Boolean         @default(false)
  acknowledged      Boolean         @default(false)
  changeWeight      Int             @default(1)

  @@unique([scheduleVersionId, dutyId])
  @@index([facultyId, scheduleVersionId])
}

model Disruption {
  id                String          @id @default(cuid())
  type              DisruptionType
  facultyId         String?
  faculty           Faculty?        @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  eventId           String?
  event             Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  startsAt          DateTime?       @db.Timestamptz(3)
  endsAt            DateTime?       @db.Timestamptz(3)
  reason            String?
  metadata          Json?
  proposedVersionId Int?
  proposedVersion   ScheduleVersion? @relation(fields: [proposedVersionId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  @@index([type, createdAt])
}
